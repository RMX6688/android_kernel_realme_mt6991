&cpu_power_throttling {
    lbat-max-level = <3>;
    lbat-limit-freq-lv1 = < 2000000 2600000 2500000>;
    lbat-limit-freq-lv2 = < 900000 1500000 1600000>;
    lbat-limit-freq-lv3 = < 800000 800000 1200000>;

	soc-max-level = <3>;
	soc-core-active-lv1 = < 1 1 1 1 1 1 1 1 >;
	soc-core-active-lv2 = < 1 1 1 1 1 1 1 1 >;
	soc-core-active-lv3 = < 1 1 1 1 1 1 1 1 >;

	soc-limit-freq-lv1 = < 2147483647  2147483647 2147483647 >;
	soc-limit-freq-lv2 = < 1700000 2400000 2000000>;
	soc-limit-freq-lv3 = < 900000 2000000 1800000>;
};

&gpu_power_throttling {
    lbat-max-level = <3>;
    lbat-limit-freq-lv1 = <1200000>;
    lbat-limit-freq-lv2 = <598000>;
    lbat-limit-freq-lv3 = <260000>;
};

&bp_thl {
	max-throttle-level = <3>;   //+lv3
	soc-throttle-level =
		<0 1 1 1 2 3>;
	soc-max-stage = <5>;
	soc-limit-threshold = <25 15 10 5 2>;
};

