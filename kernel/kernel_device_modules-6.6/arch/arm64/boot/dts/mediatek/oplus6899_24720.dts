#include "k6899v1_64.dts"

/* #ifdef OPLUS_FEATURE_CHG_BASIC */
/* Add for 24P charge device-tree */
#include "mediatek/oplus_chg/oplus_charge_24720.dtsi"
/* #endif */

/* #ifdef OPLUS_FEATURE_CHG_BASIC */
#include "mediatek/oplus_misc_24720.dtsi"
/* #endif */

/* #ifdef OPLUS_FEATURE_SENSOR */
#include "mediatek/oplus_sensor_24613.dtsi"
/* #endif */

/* #ifdef OPLUS_DISPLAY_FEATURE */
#include "mediatek/oplus-display/mt6899-brz-24720-display-overlay.dtsi"
/* #endif */

&odm {
	/*OPLUS_FEATURE_OEM_OCDT oppo project start */
	oplus_project:oplus_project {
		compatible = "oplus,oplus_project";
    };

    oplus_boardid:oplus_boardid {
        compatible = "oplus,oplus_boardid-v2";
        support-dtsino=<24720>;//only one u32
        /*first one is low 32bit, last one is highest 32bit, must be 32-bit for 4gpios*/
        support-pcbmask=<0xffffffff 0xffffffff 0xffffffff>;
    };
};

&odm {
/* Add for sim detect */
    oplus_sim_detect {
        compatible = "oplus, sim_detect";
        Hw,sim_det = <&pio 58 0x00>;
    };
};

&pio {
	//#ifdef OPLUS_VENDOR_SWTP
	swtp: swtp {
		compatible = "mediatek, swtp-eint";
	};
	 swtp_1: swtp_1 {
        compatible = "mediatek, swtp1-eint";
    };
	//#endif  /*OPLUS_VENDOR_SWTP*/
};

&low_battery_throttling {
	pt-shutdown-enable = <0>;
	temperature-max-stage = <4>;
	temperature-stage-threshold = <25 10 0 (-10)>;
	bat0-thd-volts-l = <
			3300 3100 2950
			3550 3400 3200
			3850 3700 3400
			4050 3900 3500
			4250 4040 3580>;
	bat0-thd-volts-h = <
			3400 3300 3100
			3600 3550 3400
			3900 3850 3700
			4100 4050 3900
			4300 4250 4040>;
	bat1-thd-volts-l = <
			3300 3100 2950
			3550 3400 3200
			3850 3700 3400
			4050 3900 3500
			4250 4040 3580>;
